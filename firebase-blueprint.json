{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered civic user or administrator profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["citizen", "officer", "admin"] },
        "badgeNumber": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 128 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "email", "name", "role"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Civic incident or infrastructure complaint report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "maxLength": 64 },
        "department": { "type": "string", "maxLength": 128 },
        "assignedCrew": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 512 },
        "description": { "type": "string", "maxLength": 8192 },
        "slaRemaining": { "type": "string", "maxLength": 128 },
        "totalSlaHours": { "type": "number" },
        "slaStatus": { "type": "string", "maxLength": 64 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "citizenToken": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "category", "priority", "status", "description"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Authorized municipal administrative account record",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents keyed by Firebase Auth UID"
    },
    "/complaints/{complaintId}": {
      "schema": "Complaint",
      "description": "Civic complaints and incident tracking collection"
    },
    "/admins/{userId}": {
      "schema": "Admin",
      "description": "Designated administrator role registry"
    }
  }
}
